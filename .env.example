# Copy this file to .env and fill in real values.
# .env is in .gitignore and should NEVER be committed to GitHub.

# Your new, scoped SurveyMonkey API token (read-only: View Surveys, View Responses)
SURVEYMONKEY_API_TOKEN=

# Password the Texas Roadhouse client will use to log in
CLIENT_TEXAS_ROADHOUSE_PASSWORD=

# Random string used to secure login sessions - any long random value works
FLASK_SECRET_KEY=
